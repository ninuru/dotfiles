#!/usr/bin/env bash

WALLPAPER_DIR="$HOME/wallpapers/"
INDEX_FILE="$HOME/.cache/wallpaper-index"

mapfile -t WALLPAPERS < <(find "$WALLPAPER_DIR" -type f | sort)
COUNT=${#WALLPAPERS[@]}

if [[ $COUNT -eq 0 ]]; then
    exit 1
fi

CURRENT_INDEX=$(cat "$INDEX_FILE" 2>/dev/null)
if [[ -z "$CURRENT_INDEX" || "$CURRENT_INDEX" -lt 0 || "$CURRENT_INDEX" -ge "$COUNT" ]]; then
    CURRENT_INDEX=0
fi

NEXT_INDEX=$(( (CURRENT_INDEX + 1) % COUNT ))
echo "$NEXT_INDEX" > "$INDEX_FILE"

hyprctl hyprpaper wallpaper ,"${WALLPAPERS[$NEXT_INDEX]}"
